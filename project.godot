; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Afterlight"
config/description="RPG idle / aventure, fan-game non officiel dans l'univers de Frieren."
run/main_scene="res://game/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Content="*res://game/data/content_db.gd"
Settings="*res://game/state/settings.gd"
GameState="*res://game/state/game_state.gd"
SaveService="*res://game/persistence/save_service.gd"
UiProbe="*res://game/ui/ui_probe.gd"
Router="*res://game/app/router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[internationalization]

locale/fallback="fr"
locale/translations=PackedStringArray("res://game/i18n/strings.fr.translation")

[gui]

theme/custom_font="res://assets/fonts/AlegreyaSans-Regular.ttf"

[physics]

common/max_physics_steps_per_frame=15

[shader_globals]

hero_depth={
"type": "float",
"value": 0.0
}
hero_cut_radius={
"type": "float",
"value": 0.0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"compress/lossy_quality": 0.8,
"compress/mode": 1,
"detect_3d/compress_to": 0
}
